@page "/reporte-compras"
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Modulo de Compras</PageTitle>

<style>
    #purchase-print-area {
        position: fixed;
        left: -9999px;
        top: 0;
        width: 21cm;
    }
    @@media print {
        html, body,
        .niux-shell, .niux-body, .niux-main {
            overflow: visible !important;
            height: auto !important;
            min-height: 0 !important;
            position: static !important;
        }
        body * { visibility: hidden; }
        #purchase-print-area, #purchase-print-area * { visibility: visible; }
        #purchase-print-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }
        table { page-break-inside: auto; }
        tr { page-break-inside: avoid; page-break-after: auto; }
        thead { display: table-header-group; }
        tfoot { display: table-footer-group; }
    }

    .btn-print-suggestion {
        background-color: #198754;
        border-color: #198754;
        color: #fff;
    }
    .btn-print-suggestion:hover:not(:disabled) {
        background-color: #fff;
        border-color: #198754;
        color: #198754;
    }
</style>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0">Modulo de Compras</h2>
        @if (Vm.Items.Count > 0)
        {
            <button class="btn btn-print-suggestion btn-sm" @onclick="HandlePrint"
                    disabled="@(PrintItems.Count == 0)"
                    title="@(PrintItems.Count == 0 ? "No hay productos con compra sugerida" : $"{PrintItems.Count} SKUs con compra sugerida")">
                Imprimir sugerencia de compra
            </button>
        }
    </div>

    <PurchaseReportFilters Vm="Vm" OnLoad="HandleLoad" OnClearFilters="HandleClearFilters" OnFilterChanged="StateHasChanged" />

    <PurchaseReportParamsPanel Vm="Vm" OnApply="HandleLoad" />

    @if (Vm.IsLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" style="width:3rem;height:3rem" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted fs-6">Generando reporte de compra inteligente...</p>
        </div>
    }
    else if (Vm.ErrorMessage is not null)
    {
        <div class="alert alert-danger mt-3">@Vm.ErrorMessage</div>
    }
    else if (string.IsNullOrWhiteSpace(Vm.SelectedTenantId))
    {
        <div class="text-center text-muted my-5">
            <p class="fs-5">Selecciona una sucursal para generar el reporte.</p>
        </div>
    }
    else if (Vm.Items.Count > 0)
    {
        <PurchaseReportSummaryCards Vm="Vm" OnFilterChanged="StateHasChanged" />

        <div id="purchase-print-area">
            <PurchaseSuggestionPrintView Items="PrintItems"
                                         BranchName="@TenantDisplayName"
                                         Family="@Vm.SelectedFamily"
                                         SubFamily="@(Vm.SelectedSubFamily ?? string.Empty)" />
        </div>

        <div class="row g-3">
            <div class="@(Vm.SelectedItem is not null ? "col-lg-8" : "col-12")">
                <PurchaseReportTable Vm="Vm" OnRowClick="HandleRowClick" OnPageChanged="StateHasChanged" />
            </div>
            @if (Vm.SelectedItem is not null)
            {
                <div class="col-lg-4">
                    <PurchaseReportDetailPanel Item="Vm.SelectedItem" OnClose="HandleCloseDetail" WindowDays="Vm.WindowDays" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-muted my-5">
            <p class="fs-5">No se encontraron resultados para esta consulta. Intenta nuevamente.</p>
        </div>
    }
</div>

