<div class="card mb-3">
    <div class="card-body py-2 px-3">
        <div class="d-flex justify-content-between align-items-center" style="cursor:pointer" @onclick="TogglePanel">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold small text-muted text-uppercase">Parámetros del cálculo</span>
                @if (!_expanded)
                {
                    <span class="text-muted small">
                        @Vm.WindowDays d &middot; revisión @Vm.ReviewFrequencyDays d &middot; servicio @Vm.ServiceLevelPercent.ToString("G")% &middot; proveedor @Vm.DefaultSupplierDays d &middot; stock mínimo @Vm.MinOperationalStock.ToString("G") &middot; XYZ @Vm.XyzPresetNames[Vm.XyzTolerancePreset - 1]
                    </span>
                }
            </div>
            <span class="text-muted small">@(_expanded ? "▲" : "▼")</span>
        </div>

        @if (_expanded)
        {
            <hr class="my-2" />

            <div class="row g-3 align-items-end mb-2">
                <div class="col-sm-6 col-md-2">
                    <label class="form-label small fw-semibold">Días análisis ventas</label>
                    <select class="form-select form-select-sm" @bind="_windowDays" disabled="@Vm.IsLoading">
                        <option value="30">30 días</option>
                        <option value="45">45 días</option>
                        <option value="60">60 días</option>
                        <option value="90">90 días</option>
                    </select>
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label small fw-semibold">Frecuencia revisión</label>
                    <select class="form-select form-select-sm" @bind="_reviewFrequencyDays" disabled="@Vm.IsLoading">
                        <option value="7">7 días</option>
                        <option value="14">14 días</option>
                        <option value="30">30 días</option>
                    </select>
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label small fw-semibold">Nivel de servicio</label>
                    <select class="form-select form-select-sm" @bind="_serviceLevelPercent" disabled="@Vm.IsLoading">
                        <option value="90">90%</option>
                        <option value="95">95%</option>
                        <option value="97.5">97.5%</option>
                        <option value="99">99%</option>
                    </select>
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label small fw-semibold">Días proveedor default</label>
                    <input type="number" class="form-control form-control-sm" min="1" step="1"
                           @bind="_defaultSupplierDays" disabled="@Vm.IsLoading" />
                </div>
                <div class="col-sm-6 col-md-2">
                    <label class="form-label small fw-semibold">Stock mínimo operativo</label>
                    <input type="number" class="form-control form-control-sm" min="0" step="0.5"
                           @bind="_minOperationalStock" disabled="@Vm.IsLoading" />
                </div>
                <div class="col-sm-12 col-md-2 d-flex flex-column gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="HandleApply"
                            disabled="@(Vm.IsLoading || string.IsNullOrWhiteSpace(Vm.SelectedTenantId))">
                        @if (Vm.IsLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        Aplicar parámetros
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="HandleRestore"
                            disabled="@Vm.IsLoading">
                        Restaurar defaults
                    </button>
                </div>
            </div>

            <hr class="my-2" />

            <div class="row align-items-center g-2">
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-0">Tolerancia a variación de demanda</label>
                </div>
                <div class="col-md-5">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small text-nowrap">Muy estricta</span>
                        <input type="range" class="form-range flex-grow-1" min="1" max="5" step="1"
                               value="@_xyzTolerancePreset"
                               @oninput="e => _xyzTolerancePreset = int.Parse(e.Value!.ToString()!)"
                               disabled="@Vm.IsLoading" />
                        <span class="text-muted small text-nowrap">Muy tolerante</span>
                    </div>
                    <div class="d-flex justify-content-center mt-1">
                        <span class="badge bg-primary">@Vm.XyzPresetNames[_xyzTolerancePreset - 1]</span>
                    </div>
                </div>
                <div class="col-md-5">
                    <p class="text-muted small mb-1">
                        Mientras más alta sea la tolerancia, el sistema será más flexible con productos que se venden por temporadas o de forma irregular al clasificarlos por su tipo de demanda.
                    </p>
                </div>
            </div>
        }
    </div>
</div>

