<div class="card mb-3">
    <div class="card-body">
        @if (Vm.CatalogErrorMessage is not null)
        {
            <div class="alert alert-warning py-2 mb-3">@Vm.CatalogErrorMessage</div>
        }

        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Sucursal <span class="text-danger">*</span></label>
                <select class="form-select" disabled="@(Vm.IsLoadingCatalog || Vm.IsLoading)"
                        @bind="Vm.SelectedTenantId" @bind:after="HandleTenantChanged">
                    <option value="">Selecciona una sucursal...</option>
                    @foreach (var t in Vm.Tenants)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Familia</label>
                <select class="form-select" disabled="@(Vm.IsLoadingCatalog || Vm.IsLoading)"
                        @bind="Vm.SelectedFamily" @bind:after="HandleFamiliaChanged">
                    <option value="@Vm.AllFamilies">Todas</option>
                    @foreach (var f in Vm.Families)
                    {
                        <option value="@f">@f</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">SubFamilia</label>
                <select class="form-select" disabled="@(Vm.IsLoadingCatalog || Vm.IsLoading || Vm.SelectedFamily == Vm.AllFamilies || !Vm.Subfamilies.Any())"
                        @bind="Vm.SelectedSubFamily">
                    <option value="">Todas</option>
                    @foreach (var s in Vm.Subfamilies)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkSugerida"
                           @bind="Vm.OnlyWithSuggestedPurchase" @bind:after="NotifyChanged" />
                    <label class="form-check-label" for="chkSugerida">Solo con compra sugerida</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkCriticos"
                           @bind="Vm.OnlyCritical" @bind:after="NotifyChanged" />
                    <label class="form-check-label" for="chkCriticos">Solo críticos</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="chkRevision"
                           @bind="Vm.OnlyRequiresReview" @bind:after="NotifyChanged" />
                    <label class="form-check-label" for="chkRevision">Solo requiere revisión</label>
                </div>
            </div>

            <div class="col-md-2 d-flex flex-column gap-2">
                <button class="btn btn-primary" @onclick="OnLoad"
                        disabled="@(Vm.IsLoading || Vm.IsLoadingCatalog || string.IsNullOrWhiteSpace(Vm.SelectedTenantId))">
                    @if (Vm.IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    Generar reporte
                </button>
                <button class="btn btn-outline-secondary" @onclick="OnClearFilters"
                        disabled="@Vm.IsLoading">
                    Limpiar filtros
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public IPurchaseReportViewModel Vm { get; set; } = default!;
    [Parameter] public EventCallback OnLoad { get; set; }
    [Parameter] public EventCallback OnClearFilters { get; set; }
    [Parameter] public EventCallback OnFilterChanged { get; set; }

    private async Task HandleTenantChanged()
    {
        await Vm.OnTenantChangedAsync();
        await OnFilterChanged.InvokeAsync();
    }

    private async Task HandleFamiliaChanged()
    {
        await Vm.OnFamilyChangedAsync();
        await OnFilterChanged.InvokeAsync();
    }

    private async Task NotifyChanged()
    {
        Vm.ResetPagination();
        await OnFilterChanged.InvokeAsync();
    }
}
