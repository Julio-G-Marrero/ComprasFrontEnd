<div class="card h-100">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
        <strong class="small">Detalle de producto</strong>
        <button type="button" class="btn-close" @onclick="OnClose"></button>
    </div>
    <div class="card-body overflow-auto p-2" style="max-height:calc(100vh - 260px)">
        @if (Item is not null)
        {
            <p class="fw-bold text-primary mb-0"><code>@Item.Sku</code></p>
            <p class="text-muted small mb-3">@LegacyTextNormalizer.Normalize(Item.Description)</p>

            <p class="fw-semibold small text-uppercase text-muted mb-1">Clasificación</p>
            @Row("Familia", LegacyTextNormalizer.Normalize(Item.Family))
            @Row("SubFamilia", LegacyTextNormalizer.Normalize(Item.SubFamily))
            @Row("ABC", Item.Abc)
            @Row("XYZ", Item.Xyz)

            <p class="fw-semibold small text-uppercase text-muted mt-3 mb-1">Inventario y demanda</p>
            @Row("Existencia efectiva", Item.EffectiveStock.ToString("N2"))
            @Row($"Ventas {WindowDays} días", Item.SalesPeriodQuantity.ToString("N2"))
            @Row("Demanda diaria", Item.DailyDemand.ToString("N4"))
            @Row("Desviación estándar diaria", Item.DailyStandardDeviation.ToString("N4"))
            @Row("Coeficiente de variación", Item.CoefficientOfVariation.HasValue ? Item.CoefficientOfVariation.Value.ToString("N4") : "-")

            <p class="fw-semibold small text-uppercase text-muted mt-3 mb-1">Interpretación de inventario</p>
            @Row("Estado inventario", InventarioLabel(Item.InventoryStatus))
            @Row("Días cobertura actual", Item.CurrentCoverageDays.HasValue ? $"{Item.CurrentCoverageDays.Value:N2} días" : "-")
            @Row("Exceso inventario", Item.ExcessInventory.ToString("N2"))
            @Row("% exceso inventario", Item.ExcessInventoryPercentage.HasValue ? $"{Item.ExcessInventoryPercentage.Value:N2}%" : "-")
            @Row("Motivo inventario", string.IsNullOrEmpty(Item.InventoryReason) ? "-" : LegacyTextNormalizer.Normalize(Item.InventoryReason))

            <p class="fw-semibold small text-uppercase text-muted mt-3 mb-1">Parámetros de reorden</p>
            @Row("Días proveedor", Item.SupplierLeadTimeDays.ToString("N0"))
            @Row("Frecuencia revisión", Item.ReviewFrequencyDays.ToString("N0"))
            @Row("Periodo protección", Item.ProtectionPeriodDays.ToString("N2"))
            @Row("Stock seguridad", Item.SafetyStock.ToString("N2"))
            @Row("Stock mínimo operativo", Item.MinimumOperationalStock.ToString("N2"))
            @Row("ROP", Item.Rop.ToString("N2"))
            @Row("Inv. objetivo rotación", Item.RotationTargetInventory.ToString("N2"))
            @Row("Inv. objetivo final", Item.FinalTargetInventory.ToString("N2"))

            <p class="fw-semibold small text-uppercase text-muted mt-3 mb-1">Compra sugerida</p>
            @Row("Cantidad bruta", Item.GrossQuantity.ToString("N2"))
            @Row("Cantidad por empaque", Item.UnitsPerPackage.ToString("N0"))
            @Row("Paquetes sugeridos", Item.SuggestedPackages.ToString("N0"))
            <div class="d-flex justify-content-between border-bottom py-1 small">
                <span class="text-muted">Cantidad sugerida</span>
                <span class="fw-bold text-primary">@Item.SuggestedQuantity.ToString("N2")</span>
            </div>
            @Row("Motivo compra", LegacyTextNormalizer.Normalize(Item.PurchaseReason))

            <p class="fw-semibold small text-uppercase text-muted mt-3 mb-1">Alertas</p>
            @Row("Nivel alerta", Item.AlertLevel.ToUpperInvariant() == "BAJO" ? "Sin alerta" : Item.AlertLevel)
            @if (Item.RequiresReview)
            {
                @Row("Motivo revisión", LegacyTextNormalizer.Normalize(Item.ReviewReason))
            }
        }
    </div>
</div>

@code {
    [Parameter] public PurchaseReportLine? Item { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public int WindowDays { get; set; } = 45;

    private static string InventarioLabel(string estado) => estado.ToUpperInvariant() switch
    {
        "SALUDABLE"           => "Óptimo",
        "BAJO_OBJETIVO"       => "Bajo objetivo",
        "SOBRESTOCK"          => "Sobrestock",
        "SIN_VENTA_CON_STOCK" => "Sin venta con stock",
        _                     => string.IsNullOrEmpty(estado) ? "-" : estado
    };

    private static RenderFragment Row(string label, string value) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "d-flex justify-content-between border-bottom py-1 small");
        __builder.OpenElement(2, "span");
        __builder.AddAttribute(3, "class", "text-muted");
        __builder.AddContent(4, label);
        __builder.CloseElement();
        __builder.OpenElement(5, "span");
        __builder.AddAttribute(6, "class", "fw-semibold text-end");
        __builder.AddContent(7, value);
        __builder.CloseElement();
        __builder.CloseElement();
    };
}
