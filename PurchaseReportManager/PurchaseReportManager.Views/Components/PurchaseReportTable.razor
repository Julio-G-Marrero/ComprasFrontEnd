<div class="mb-2" style="max-width:500px">
    <div class="input-group">
        <span class="input-group-text">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/>
            </svg>
        </span>
        <input type="text" class="form-control form-control-sm"
               placeholder="Buscar por SKU, descripción, familia, ABC, XYZ, motivo…"
               value="@Vm.SearchText"
               @oninput="HandleSearch" />
        @if (!string.IsNullOrEmpty(Vm.SearchText))
        {
            <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="HandleClearSearch"
                    title="Limpiar búsqueda">&#x2715;</button>
        }
    </div>
</div>

@if (!Vm.FilteredItems.Any())
{
    <div class="text-center text-muted py-4 border rounded">
        @(string.IsNullOrWhiteSpace(Vm.SearchText)
            ? "No hay productos para los filtros seleccionados."
            : "No hay productos que coincidan con la búsqueda y filtros seleccionados.")
    </div>
}
else
{
    <div class="table-responsive purchase-table-wrapper">
        <table class="table table-sm table-hover table-bordered align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    @SortHeader("SKU",          "sku",          "")
                    @SortHeader("Descripción",  "description",  "")
                    @SortHeader("Familia",      "family",       "")
                    @SortHeader("SubFamilia",   "subfamily",    "")
                    <th class="text-center">Req.Stock</th>
                    @SortHeader("Existencia",   "stock",        "text-end")
                    @SortHeader($"Ventas {Vm.WindowDays}d", "sales", "text-end")
                    @SortHeader("ABC",          "abc",          "text-center")
                    @SortHeader("XYZ",          "xyz",          "text-center")
                    <th class="text-end">Cant/Emp</th>
                    <th class="text-end">Paq.Sug.</th>
                    @SortHeader("Cant.Sug.",    "suggestedqty", "text-end")
                    <th>Motivo Compra</th>
                    @SortHeader("Alerta",       "alert",       "text-center")
                    @SortHeader("Inventario",   "inventory",   "text-center")
                    <th class="text-center">Revisión</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Vm.PagedItems)
                {
                    <tr class="@(Vm.SelectedItem == item ? "table-active" : "")"
                        style="cursor:pointer"
                        @onclick="() => OnRowClick.InvokeAsync(item)">
                        <td><code class="text-nowrap">@item.Sku</code></td>
                        <td class="text-nowrap" style="max-width:200px;overflow:hidden;text-overflow:ellipsis" title="@LegacyTextNormalizer.Normalize(item.Description)">@LegacyTextNormalizer.Normalize(item.Description)</td>
                        <td>@LegacyTextNormalizer.Normalize(item.Family)</td>
                        <td>@LegacyTextNormalizer.Normalize(item.SubFamily)</td>
                        <td class="text-center">@(item.RequiresStock ? "✓" : "")</td>
                        <td class="text-end">@item.EffectiveStock.ToString("N2")</td>
                        <td class="text-end">@item.SalesPeriodQuantity.ToString("N2")</td>
                        <td class="text-center"><span class="badge bg-secondary">@item.Abc</span></td>
                        <td class="text-center"><span class="badge bg-secondary">@item.Xyz</span></td>
                        <td class="text-end">@item.UnitsPerPackage.ToString("N0")</td>
                        <td class="text-end">@item.SuggestedPackages.ToString("N0")</td>
                        <td class="text-end fw-bold @(item.HasSuggestion ? "text-primary" : "")">@item.SuggestedQuantity.ToString("N2")</td>
                        <td><small class="text-nowrap">@LegacyTextNormalizer.Normalize(item.PurchaseReason)</small></td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.AlertLevel))
                            {
                                <span class="@AlertBadgeClass(item.AlertLevel)">@AlertDisplayText(item.AlertLevel)</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.InventoryStatus))
                            {
                                <span class="@InventarioBadgeClass(item.InventoryStatus)" title="@LegacyTextNormalizer.Normalize(item.InventoryReason)">
                                    @InventarioLabel(item.InventoryStatus)
                                </span>
                            }
                            else { <span class="text-muted small">-</span> }
                        </td>
                        <td class="text-center">@(item.RequiresReview ? "✓" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <div class="text-muted small">
            Mostrando @Vm.PagedFrom–@Vm.PagedTo de @Vm.FilteredItems.Count productos
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-secondary" @onclick="HandlePrevious"
                    disabled="@(Vm.CurrentPage <= 1)">Anterior</button>
            <span class="small">Página @Vm.CurrentPage de @Vm.TotalPages</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="HandleNext"
                    disabled="@(Vm.CurrentPage >= Vm.TotalPages)">Siguiente</button>
        </div>
    </div>
}

