<div class="row g-3 mb-3">

    <div class="col-sm">
        <div class="card text-center h-100">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">Total SKUs</p>
                <p class="fs-4 fw-bold mb-0">@Vm.TotalSkus</p>
            </div>
        </div>
    </div>

    <div class="col-sm">
        <div class="@CardClass(Vm.OnlyWithSuggestedPurchase, "success")"
             style="@CardStyle(Vm.OnlyWithSuggestedPurchase, "rgba(25,135,84,0.10)")"
             @onclick="HandleToggleSugerida"
             title="Click para filtrar por compra sugerida">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">SKUs con compra sugerida</p>
                <p class="fs-4 fw-bold text-success mb-0">@Vm.SkusConCompraSugerida</p>
            </div>
        </div>
    </div>

    <div class="col-sm">
        <div class="card text-center h-100 border-primary">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">Cantidad total sugerida</p>
                <p class="fs-4 fw-bold text-primary mb-0">@Vm.TotalSuggestedQuantity.ToString("N2")</p>
            </div>
        </div>
    </div>

    <div class="col-sm">
        <div class="@CardClass(Vm.OnlyCritical, "danger")"
             style="@CardStyle(Vm.OnlyCritical, "rgba(220,53,69,0.10)")"
             @onclick="HandleToggleCriticos"
             title="Click para filtrar por productos criticos">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">Productos criticos</p>
                <p class="fs-4 fw-bold text-danger mb-0">@Vm.CriticalProducts</p>
            </div>
        </div>
    </div>

    <div class="col-sm">
        <div class="@CardClass(Vm.OnlyRequiresReview, "warning")"
             style="@CardStyle(Vm.OnlyRequiresReview, "rgba(255,193,7,0.15)")"
             @onclick="HandleToggleRevision"
             title="Click para filtrar productos a revision">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">Productos a revision</p>
                <p class="fs-4 fw-bold text-warning mb-0">@Vm.ReviewProducts</p>
            </div>
        </div>
    </div>

    <div class="col-sm">
        <div class="card text-center h-100">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">Ventas @Vm.WindowDays d</p>
                <p class="fs-4 fw-bold mb-0">@Vm.TotalSales.ToString("N2")</p>
            </div>
        </div>
    </div>

    <div class="col-sm">
        <div class="card text-center h-100">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">Existencia efectiva</p>
                <p class="fs-4 fw-bold mb-0">@Vm.TotalEffectiveStock.ToString("N2")</p>
            </div>
        </div>
    </div>

</div>

