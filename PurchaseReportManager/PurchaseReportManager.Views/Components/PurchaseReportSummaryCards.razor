<div class="row g-3 mb-3">

    <div class="col-sm">
        <div class="card text-center h-100">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">Total SKUs</p>
                <p class="fs-4 fw-bold mb-0">@Vm.TotalSkus</p>
            </div>
        </div>
    </div>

    <div class="col-sm">
        <div class="@CardClass(Vm.SoloConCompraSugerida, "success")"
             style="@CardStyle(Vm.SoloConCompraSugerida, "rgba(25,135,84,0.10)")"
             @onclick="HandleToggleSugerida"
             title="Click para filtrar por compra sugerida">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">SKUs con compra sugerida</p>
                <p class="fs-4 fw-bold text-success mb-0">@Vm.SkusConCompraSugerida</p>
            </div>
        </div>
    </div>

    <div class="col-sm">
        <div class="card text-center h-100 border-primary">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">Cantidad total sugerida</p>
                <p class="fs-4 fw-bold text-primary mb-0">@Vm.CantidadTotalSugerida.ToString("N0")</p>
            </div>
        </div>
    </div>

    <div class="col-sm">
        <div class="@CardClass(Vm.SoloCriticos, "danger")"
             style="@CardStyle(Vm.SoloCriticos, "rgba(220,53,69,0.10)")"
             @onclick="HandleToggleCriticos"
             title="Click para filtrar por productos criticos">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">Productos criticos</p>
                <p class="fs-4 fw-bold text-danger mb-0">@Vm.ProductosCriticos</p>
            </div>
        </div>
    </div>

    <div class="col-sm">
        <div class="@CardClass(Vm.SoloRequiereRevision, "warning")"
             style="@CardStyle(Vm.SoloRequiereRevision, "rgba(255,193,7,0.15)")"
             @onclick="HandleToggleRevision"
             title="Click para filtrar productos a revision">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">Productos a revision</p>
                <p class="fs-4 fw-bold text-warning mb-0">@Vm.ProductosRevision</p>
            </div>
        </div>
    </div>

    <div class="col-sm">
        <div class="card text-center h-100">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">Ventas 45 dias</p>
                <p class="fs-4 fw-bold mb-0">@Vm.VentasTotales45Dias.ToString("N0")</p>
            </div>
        </div>
    </div>

    <div class="col-sm">
        <div class="card text-center h-100">
            <div class="card-body py-2">
                <p class="card-text text-muted small mb-1">Existencia efectiva</p>
                <p class="fs-4 fw-bold mb-0">@Vm.TotalExistenciaEfectiva.ToString("N0")</p>
            </div>
        </div>
    </div>

</div>

@code {
    [Parameter] public PurchaseReportViewModel Vm { get; set; } = default!;
    [Parameter] public EventCallback OnFilterChanged { get; set; }

    private async Task HandleToggleSugerida()
    {
        Vm.ToggleSoloCompraSugerida();
        await OnFilterChanged.InvokeAsync();
    }

    private async Task HandleToggleCriticos()
    {
        Vm.ToggleSoloCriticos();
        await OnFilterChanged.InvokeAsync();
    }

    private async Task HandleToggleRevision()
    {
        Vm.ToggleSoloRevision();
        await OnFilterChanged.InvokeAsync();
    }

    private static string CardClass(bool active, string color) =>
        $"card text-center h-100 border-{color}{(active ? " border-2 shadow-sm" : "")}";

    private static string CardStyle(bool active, string bg) =>
        active ? $"cursor:pointer;background-color:{bg};transition:all .15s"
               : "cursor:pointer;transition:all .15s";
}
